<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Analisis06_6133261.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">
            <Label Text="CONVERSOR DOLARES" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

            <Label Text="Cantidad en pesos mexicanos:"/>
            <Entry x:Name="PesosEntry" Placeholder="Ejemplo: 1000" Keyboard="Numeric"/>

            <Label Text="Tipo de cambio (pesos por dolar):"/>
            <Entry x:Name="TipoCambioEntry" Placeholder="Ejemplo: 18.50" Keyboard="Numeric"/>

            <Button Text="Calcular Dolares" Clicked="CalcularDolares"/>

            <Label x:Name="ResultadoLabel" FontSize="18" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
